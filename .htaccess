Options -Indexes
RewriteEngine On

# Bloquear acesso direto à pasta config
RewriteRule ^config/ - [F,L]

# Arquivos reais (CSS, JS, imagens, PDFs) são servidos diretamente
# Diretórios e rotas PHP passam pelo router index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
