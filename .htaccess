Options -Indexes
DirectoryIndex index.html index.php
RewriteEngine On

# Bloquear acesso direto à pasta config
RewriteRule ^config/ - [F,L]

# Se o diretório acessado contém index.html, redireciona direto para ele
# Funciona para qualquer pasta com index.html sem precisar listar uma a uma
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ /$1/index.html [R=301,L]

# Arquivos físicos são servidos diretamente
# Apenas rotas inexistentes passam pelo router index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
